# ─── Required ────────────────────────────────────────────────────

# Shared secret. Every HTTP request from the dashboard must send this
# as `Authorization: Bearer <token>`. Use a long random string.
WORKER_API_TOKEN=change-me-to-a-long-random-string

# Deepgram — live speech-to-text. https://console.deepgram.com/
# This is the master key; it stays server-side here, so no token grant
# is needed (unlike the browser path in the dashboard).
DEEPGRAM_API_KEY=

# Anthropic — translation. https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ─── Optional ────────────────────────────────────────────────────

# Claude model used for translation (fast + cheap by default).
TRANSLATION_MODEL=claude-haiku-4-5

# HTTP/WebSocket port the worker listens on.
PORT=8080

# The display name the bot shows as inside the meeting.
BOT_DISPLAY_NAME=LenguaLive Notetaker

# PulseAudio null-sink the bot's Chromium plays into.
# MUST match the sink name created in docker/entrypoint.sh.
AUDIO_SINK=meet_sink
